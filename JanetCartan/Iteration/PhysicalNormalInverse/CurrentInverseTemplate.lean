module

public meta import Lean

/-!
# Preserve the old inverse-cap interface while retaining stronger scalar data

Only the new strong-current path uses the two additional scalar certificates.
The historical inverse-cap declaration is generated by ordinary logical
weakening, with its original native telescope and unchanged physical tail.
No old and new selected witnesses are identified.
-/

public meta section
namespace JanetCartan.PhysicalNormalInverse.CurrentInverseTemplate
open Lean Meta Elab Command

/-- Keep the old public inverse theorem type by erasing only the extra
pre-scale scalar admission clauses. The proof is checked by the kernel. -/
elab "retain_original_inverse_cap_interface" : command => liftTermElabM do
  let source := `JanetCartan.PhysicalNormalInverse.exists_capped_source_history_inverse_with_scalar_admission
  let name := `JanetCartan.PhysicalNormalInverse.exists_capped_source_history_inverse_from_original_leading
  let info ← getConstInfo source
  let levels := info.levelParams.map Level.param
  forallTelescope info.type fun params _ => do
    unless params.size == 121 do
      throwError "original inverse compatibility: expected all121 original static arguments"
    let proof := mkAppN (mkConst source levels) params
    let proof ← mkAppM `JanetCartan.PhysicalNormalInverse.discard_extra_scalar_admission #[proof]
    let type ← instantiateMVars (← mkForallFVars params (← inferType proof))
    let value ← instantiateMVars (← mkLambdaFVars params proof)
    if type.hasMVar || value.hasMVar || type.hasFVar || value.hasFVar ||
        type.hasLevelMVar || value.hasLevelMVar || type.hasSorry || value.hasSorry then
      throwError "original inverse compatibility: incomplete ordinary weakening"
    addDecl (.thmDecl { name, levelParams := info.levelParams, type, value }) (forceExpose := true)
    logInfo "kernel-checked original121 inverse interface; stronger scalar certificates retained only on the one strong-current choice"

end JanetCartan.PhysicalNormalInverse.CurrentInverseTemplate
