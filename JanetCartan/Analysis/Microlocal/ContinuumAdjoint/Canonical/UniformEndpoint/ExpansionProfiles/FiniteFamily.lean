module

public import JanetCartan.Analysis.Microlocal.ContinuumAdjoint.DerivativeKernels.SymbolBounds.Expressions

/-!
# Finite syntactic profiles for the adjoint derivative expansion

The branches of `app:ch_background:eq:bg-derivative-trade` determine a finite
family of coefficient expressions before the primitive functions are chosen.
This family supplies the uniform profile constant for
`exists_uniform_expansion_reserve_symbol_bound`. The exact expansion length
supplies the finite summation in the parent's raw Sobolev assembly for
`app:ch_background:prop:bg-adjoint`.
-/

@[expose] public noncomputable section
open scoped ContDiff
namespace JanetCartan.ContinuumAdjoint.Canonical.UniformEndpoint
open ContinuumRow DerivativeKernels
variable {n : ℕ}

/-- All syntactic coefficient profiles generated by the fixed derivative word,
independently of the amplitude and trade fields
(`app:ch_background:eq:bg-derivative-trade`). -/
def adjointExpansionExpressionProfiles :
    List (InitialCarrierDerivative n) → List (AdjointCoefficientExpression n)
  | [] => [.amplitude]
  | d :: ds => (adjointExpansionExpressionProfiles ds).flatMap fun e ↦
      e.zeroBranch d :: List.ofFn (e.firstBranch d)

/-- Every actual coefficient is represented in the syntactic family, with its
original `s-k` derivative budget and directions. This strengthens the expression
witness used in `app:ch_background:prop:bg-adjoint` to provide a uniform constant
before choosing the primitive functions. -/
theorem exists_profile_of_mem_adjointDerivativeExpansion (L V)
    (a : AdjointAmplitude n)
    (ha : ∀ η, ContDiff ℝ ∞ (fun p : AdjointJetPoint n ↦ a p.1 p.2 η))
    (hfield : ∀ d j, ContDiff ℝ ∞ (branchField L V d j))
    (ds : List (InitialCarrierDerivative n)) (t : AdjointDerivativeTerm n)
    (ht : t ∈ adjointDerivativeExpansion L V ds a) :
    ∃ e ∈ adjointExpansionExpressionProfiles ds,
      e.degree + t.dataDerivatives.length ≤ ds.length ∧
      e.UsesDirections ds ∧
      t.amplitude = fun z x η ↦ e.evaluate L V a η (z, x) := by
  induction ds generalizing t with
  | nil =>
      simp only [adjointDerivativeExpansion, List.mem_singleton] at ht
      subst t
      exact ⟨.amplitude, by simp [adjointExpansionExpressionProfiles],
        by simp [AdjointCoefficientExpression.degree], trivial, rfl⟩
  | cons d ds ih =>
      obtain ⟨u, hu, ht⟩ := List.mem_flatMap.mp ht
      obtain ⟨e, hem, he, hdirs, hue⟩ := ih u hu
      simp only [differentiateAdjointTerm, List.mem_cons, List.mem_ofFn] at ht
      rcases ht with rfl | ⟨j, rfl⟩
      · refine ⟨e.zeroBranch d, List.mem_flatMap.mpr ⟨e, hem, by simp⟩,
          ?_, (e.usesDirections_branches ds d hdirs).1, ?_⟩
        · have := e.degree_zeroBranch_le d
          simp only [List.length_cons]
          omega
        · dsimp only
          rw [hue]
          funext z x η
          exact (e.evaluate_zeroBranch L V a η (ha η) hfield d (z, x)).symm
      · refine ⟨e.firstBranch d j, List.mem_flatMap.mpr ⟨e, hem, by simp⟩,
          ?_, (e.usesDirections_branches ds d hdirs).2 j, ?_⟩
        · simp only [AdjointCoefficientExpression.degree_firstBranch, List.length_cons]
          omega
        · dsimp only
          rw [hue]
          funext z x η
          exact (e.evaluate_firstBranch L V a η d j (z, x)).symm

/-- The actual derivative expansion has exactly `(n+1)^s` terms, independently
of the amplitude and trade fields, including `s=0`. This is the term count for
the finite summation in `app:ch_background:prop:bg-adjoint`. -/
theorem length_adjointDerivativeExpansion (L V)
    (ds : List (InitialCarrierDerivative n)) (a : AdjointAmplitude n) :
    (adjointDerivativeExpansion L V ds a).length = (n+1)^ds.length := by
  induction ds with
  | nil => simp [adjointDerivativeExpansion]
  | cons d ds ih =>
      simp only [adjointDerivativeExpansion, List.length_flatMap,
        differentiateAdjointTerm, List.length_cons, List.length_ofFn]
      change (List.map (Function.const (AdjointDerivativeTerm n) (n+1))
        (adjointDerivativeExpansion L V ds a)).sum = (n+1)^(ds.length+1)
      rw [List.map_const, List.sum_replicate, smul_eq_mul, ih, pow_succ]

end JanetCartan.ContinuumAdjoint.Canonical.UniformEndpoint
